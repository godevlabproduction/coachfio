# --- Postgres ---
POSTGRES_USER=coachio
POSTGRES_PASSWORD=coachio
POSTGRES_DB=coachio
# Used by the app (host is the compose service name)
DATABASE_URL=postgresql+psycopg://coachio:coachio@postgres:5432/coachio

# --- Redis (Celery broker + progress pub/sub) ---
REDIS_URL=redis://redis:6379/0

# --- Object storage (MinIO, S3-compatible) ---
S3_ENDPOINT_URL=http://minio:9000
S3_PUBLIC_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=coachio
S3_SECRET_KEY=coachio-secret
S3_BUCKET=coachio-frames
S3_REGION=us-east-1

# --- Pipeline / budget ---
# Hard cap on API cost per 15-minute match (USD). Pipeline fails loudly if exceeded.
MATCH_BUDGET_USD=0.25
# Phase 0 uses no models; stages 2/3 are stubbed off.
ENABLE_STAGE_2=false
ENABLE_STAGE_3=false

# Auto-clip highlights around important moments (local ffmpeg, $0).
ENABLE_HIGHLIGHTS=true
HIGHLIGHT_WINDOW_S=4
HIGHLIGHT_FPS=4

# Usage limit: matches analysed per identity before HTTP 402 (identity is the
# X-User-Id header for now; a hosted auth provider plugs into api/deps.current_user).
FREE_MATCH_LIMIT=25

# --- OCR ---
# paddle = real PaddleOCR; stub = deterministic no-op (lets the stack boot
# before Paddle is installed / while iterating on plumbing).
OCR_ENGINE=paddle

# --- Vision (Stages 2 & 3) ---
# engine: "anthropic" (cloud) | "openai" (ANY OpenAI-compatible provider) |
#         "ollama" (local, $0) | "stub" (no-op, $0)
VISION_ENGINE=stub
ANTHROPIC_API_KEY=
STAGE2_MODEL=claude-haiku-4-5
STAGE3_MODEL=claude-sonnet-5
STAGE2_MAX_CANDIDATES=40

# Whole-match coaching read.
#  full   = read the ENTIRE match in segments then synthesise ONE report (many
#           frames; use a cheap/large-context provider). sample = one pooled call.
COACHING_MODE=full
COACHING_WINDOW_FRAMES=10    # frames per segment (map) call
COACHING_MAX_WINDOWS=24      # cap on segments - bounds total spend
COACHING_FRAME_WIDTH=768
COACHING_MAX_FRAMES=16       # "sample" mode only

# --- CHEAP CLOUD VISION via the "openai" engine ------------------------------
# Any OpenAI-compatible /chat/completions endpoint works - set base_url + key +
# STAGE*_MODEL and the $/Mtok rates (for cost logging only). Recommended:
#
#  Google Gemini 2.5 Flash - cheapest good vision + 1M context (best for "full"):
#   VISION_ENGINE=openai
#   OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#   OPENAI_API_KEY=...              # aistudio.google.com/app/apikey
#   STAGE2_MODEL=gemini-2.5-flash
#   STAGE3_MODEL=gemini-2.5-flash
#   OPENAI_INPUT_USD_PER_MTOK=0.30
#   OPENAI_OUTPUT_USD_PER_MTOK=2.50
#
#  Alibaba Qwen-VL (DashScope compatible-mode, the "chinese" option):
#   OPENAI_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
#   STAGE3_MODEL=qwen-vl-max
#
#  OpenRouter (one key, many models):
#   OPENAI_BASE_URL=https://openrouter.ai/api/v1
#   STAGE3_MODEL=google/gemini-2.5-flash
OPENAI_BASE_URL=
OPENAI_API_KEY=
OPENAI_INPUT_USD_PER_MTOK=0.30
OPENAI_OUTPUT_USD_PER_MTOK=1.20

# Local Ollama server. From a container the host is host.docker.internal;
# start Ollama with OLLAMA_HOST=0.0.0.0 so the container can reach it.
OLLAMA_BASE_URL=http://host.docker.internal:11434
# -1 = auto (GPU); 0 = force CPU. Use 0 if the GPU driver is too old for the
# CUDA build (symptom: "CUDA error: the provided PTX was compiled with an
# unsupported toolchain"). Update the NVIDIA driver to re-enable the GPU.
OLLAMA_NUM_GPU=-1

# --- FULLY-LOCAL recipe (uncomment to run both stages on-device, $0) ---
# ENABLE_STAGE_2=true
# ENABLE_STAGE_3=true
# VISION_ENGINE=ollama
# STAGE2_MODEL=gemma3:4b
# STAGE3_MODEL=gemma3:4b
# OLLAMA_NUM_GPU=0   # this laptop's GPU driver is too old; CPU works

# --- NATIVE WHOLE-VIDEO COACHING (the current main path) ---------------------
# Upload a full match video -> Gemini watches it natively -> coaching report.
# This is what the web UI at :8000 uses (source_type=video_native).
# RECOMMENDED SETUP (paste your own Gemini key from aistudio.google.com/app/apikey):
#   VISION_ENGINE=openai
#   OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#   OPENAI_API_KEY=<your key>
#   STAGE2_MODEL=gemini-flash-latest
#   STAGE3_MODEL=gemini-pro-latest
GEMINI_VIDEO_MODEL=gemini-flash-latest
GEMINI_VIDEO_SYNTH_MODEL=gemini-pro-latest
GEMINI_VIDEO_MEDIA_RES=medium
GEMINI_VIDEO_COMPRESS=true

# MODES (cost vs depth):
#  - MIDDLE MODE (default, ~$0.02-0.05/match): ONE coaching call over the whole
#    video + a small deterministic scoreboard read (accurate final score + timed
#    goal-by-goal). Best value; can't trip API rate limits.
#  - DEEP MODE: set GEMINI_VIDEO_TWO_PASS=true (multi-pass watch, deep per-goal
#    re-reads, self-learning). Better depth, ~65 API calls/match.
GEMINI_VIDEO_TWO_PASS=false
GEMINI_VIDEO_WATCH_PASSES=1
GEMINI_SCORE_READ=true
GEMINI_SCORE_MAX_FRAMES=16
GEMINI_DEEP_GOALS=false
ENABLE_SELF_LEARNING=false
ENABLE_ROSTER_OCR=false

# --- KNOWLEDGE BRAIN (adapters/ea_fc_26/knowledge/) --------------------------
# Teach the coach from tutorial videos or text notes (facts land in learned.yaml):
#   docker compose run --rm -v "<folder>:/dl:ro" api python -m tools.learn_from_video /dl/clip.mp4
#   docker compose run --rm api python -m tools.learn_from_text tools/notes_meta_v1.yaml
# Then: docker compose restart worker api

# --- API ---
API_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000
