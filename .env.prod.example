# PRODUCTION environment - copy to .env.prod on the server and fill in.
# .env.prod is gitignored; it must never leave the server.
#
#   cp .env.prod.example .env.prod
#
# Every ${...:?} value in docker-compose.prod.yml comes from here, so compose
# refuses to start with the critical ones missing.

# --- Postgres ----------------------------------------------------------------
POSTGRES_USER=coachio
# Generate: openssl rand -hex 24   (never the dev default)
POSTGRES_PASSWORD=
POSTGRES_DB=coachio
# Paste the SAME password into the URL - env files do no ${} substitution, the
# app reads this line literally.
DATABASE_URL=postgresql+psycopg://coachio:PASTE_POSTGRES_PASSWORD_HERE@postgres:5432/coachio

# --- Redis -------------------------------------------------------------------
REDIS_URL=redis://redis:6379/0

# --- Object storage (MinIO) --------------------------------------------------
S3_ENDPOINT_URL=http://minio:9000
# Public URL is unused in prod (media is served through the API), but must parse.
S3_PUBLIC_ENDPOINT_URL=http://minio:9000
S3_ACCESS_KEY=coachio
# Generate: openssl rand -hex 24
S3_SECRET_KEY=
S3_BUCKET=coachio-frames
S3_REGION=us-east-1

# --- Sessions (the values api/main.py refuses to boot without) ---------------
# Generate: openssl rand -hex 32. Anyone holding this can mint a session for
# ANY account - treat it like a root password, rotate it if it ever leaks.
SECRET_KEY=
# One cookie for the hub and every game subdomain - sign in once, play anywhere.
SESSION_COOKIE_DOMAIN=.coachfio.com
SESSION_COOKIE_SECURE=true
SESSION_MAX_AGE_DAYS=30

# --- Supabase (identity) -----------------------------------------------------
# Same project as dev unless you split environments. BEFORE LAUNCH the Supabase
# dashboard needs the production redirect URLs + custom SMTP - see DEPLOY.md.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# --- Sites: one subdomain per game -------------------------------------------
SITE_HOSTS=fifa=ea-fc@26,cs=cs2@2
SITE_ROOT_LABELS=www,app,coachfio,localhost,127

# --- Analysis (Gemini) -------------------------------------------------------
# Your PRODUCTION Gemini key (aistudio.google.com/app/apikey, billing enabled -
# the free tier 429s on full matches).
VISION_ENGINE=openai
OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
OPENAI_API_KEY=
STAGE2_MODEL=gemini-flash-latest
STAGE3_MODEL=gemini-pro-latest
OPENAI_INPUT_USD_PER_MTOK=0.30
OPENAI_OUTPUT_USD_PER_MTOK=2.50

# MIDDLE MODE to start (~$0.02-0.05/match, no 429 bursts). Flip to deep mode
# (GEMINI_VIDEO_TWO_PASS=true etc. - see .env.example) once volume and rate
# limits are understood.
GEMINI_VIDEO_TWO_PASS=false
GEMINI_VIDEO_WATCH_PASSES=1
GEMINI_SCORE_READ=true
GEMINI_SCORE_MAX_FRAMES=28
GEMINI_DEEP_GOALS=false
ENABLE_SELF_LEARNING=false
ENABLE_ROSTER_OCR=false
MATCH_BUDGET_USD=0.25

# --- Product limits ----------------------------------------------------------
# The real free-tier cap (dev runs with it effectively off).
FREE_MATCH_LIMIT=25

# --- Pipeline misc -----------------------------------------------------------
OCR_ENGINE=stub
ENABLE_STAGE_2=false
ENABLE_STAGE_3=false
ENABLE_HIGHLIGHTS=true
# Keep the 720p re-encode instead of the multi-GB original after analysis.
STORE_COMPRESSED_SOURCE=true

# --- Backups -----------------------------------------------------------------
BACKUP_RETENTION_DAYS=14

# --- CORS: same-origin in prod (frontend is served BY the api), so no extras.
API_CORS_ORIGINS=https://coachfio.com
